{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "store",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cacho-store",
      "database_id": "a41462d2-345d-4a39-8305-561fcce1f31d"
    }
  ]
}
